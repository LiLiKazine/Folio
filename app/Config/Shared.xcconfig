// Shared.xcconfig — applies to every target and configuration.
// Build settings live here, not in project.pbxproj, so an agent can read and
// edit them as text and so a green build proves they are in effect.

#include "Version.xcconfig"

// --- Swift language ---
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES

// --- Platforms ---
SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2

// --- Identity ---
PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = io.lilikaine.github.folio
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
// App Store Connect refuses an iPad build that does not support every
// orientation unless it declares UIRequiresFullScreen (validation error
// ITMS-90474; Xcode warns "All interface orientations must be supported unless
// the app requires full screen"). Folio reads in any orientation, so all four
// on iPad; on iPhone the three Xcode's own template uses.
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_NSHumanReadableCopyright = Copyright © Leo
// Folio has no encryption code and makes no network connections (zip reading
// only decompresses), so it is exempt from export compliance. Declaring it here
// stops App Store Connect asking on every build.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

// --- Signing ---
// Bootstrap must pass with no Apple Developer account configured: iOS verifies
// on the simulator (unsigned) and macOS signs ad-hoc. Hardened runtime is a
// notarization concern and is turned on by the asc-notarization skill.
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY =
CODE_SIGN_IDENTITY[sdk=macosx*] = -
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/macOS.entitlements
ENABLE_HARDENED_RUNTIME = NO
